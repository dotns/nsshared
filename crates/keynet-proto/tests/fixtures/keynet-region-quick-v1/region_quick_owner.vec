# Region quick owner agreement and fencing decisions.
# Each case starts from a fresh member state and applies its steps in order.
# A step is local|peer|link|serving. local is none or owner@epoch; peer is legacy, owner@epoch,
# or - for a local configuration change with no peer HELLO; link is agreed, inactive, mismatched,
# or - when no peer HELLO was read; serving is serve or fenced.
case=equal
step1=2@5|2@5|agreed|serve

case=equal_epoch_maximum
step1=2@18446744073709551615|2@18446744073709551615|agreed|serve

case=peer_higher_same_owner
step1=2@5|2@7|mismatched|fenced

case=peer_higher_other_owner
step1=2@5|3@7|mismatched|fenced

case=peer_higher_by_one_at_maximum
step1=2@18446744073709551614|2@18446744073709551615|mismatched|fenced

case=peer_lower_same_owner
step1=2@7|2@5|mismatched|serve

case=peer_lower_other_owner
step1=2@7|3@5|mismatched|serve

case=equal_epoch_other_owner
step1=2@5|3@5|mismatched|fenced

case=equal_epoch_other_owner_reverse
step1=3@5|2@5|mismatched|fenced

case=local_without_owner_peer_owner
step1=none|2@5|mismatched|fenced

case=local_owner_peer_legacy
step1=2@5|legacy|mismatched|serve

case=neither_owner
step1=none|legacy|inactive|serve

case=higher_fence_persists_across_agreed_links
step1=2@5|3@7|mismatched|fenced
step2=2@5|2@5|agreed|fenced
step3=2@5|legacy|mismatched|fenced
step4=2@5|2@4|mismatched|fenced

case=higher_fence_lifted_by_reload_to_highest
step1=2@5|3@7|mismatched|fenced
step2=3@7|-|-|serve
step3=3@7|3@7|agreed|serve

case=higher_fence_lifted_by_reload_above_highest
step1=2@5|3@7|mismatched|fenced
step2=4@9|-|-|serve
step3=4@9|3@7|mismatched|serve

case=higher_fence_kept_by_reload_below_highest
step1=2@5|3@7|mismatched|fenced
step2=3@6|-|-|fenced
step3=3@6|3@6|agreed|fenced

case=highest_observed_epoch_never_decreases
step1=2@5|3@9|mismatched|fenced
step2=2@5|3@7|mismatched|fenced
step3=3@7|-|-|fenced
step4=3@9|-|-|serve

case=reload_to_highest_with_other_owner_stays_fenced
step1=2@5|3@7|mismatched|fenced
step2=2@7|-|-|fenced
step3=2@8|-|-|serve

case=local_without_owner_fence_lifted_by_reload
step1=none|2@5|mismatched|fenced
step2=none|legacy|inactive|fenced
step3=2@5|-|-|serve
step4=2@5|2@5|agreed|serve

case=conflict_persists_across_agreed_links
step1=2@5|3@5|mismatched|fenced
step2=2@5|2@5|agreed|fenced
step3=2@5|-|-|fenced

case=conflict_after_agreed_link
step1=2@5|2@5|agreed|serve
step2=2@5|3@5|mismatched|fenced
step3=2@5|2@5|agreed|fenced

case=conflict_lifted_by_reload_above
step1=2@5|3@5|mismatched|fenced
step2=3@6|-|-|serve
step3=3@6|3@5|mismatched|serve

case=conflict_between_peers_above_local
step1=2@5|3@7|mismatched|fenced
step2=2@5|4@7|mismatched|fenced
step3=3@7|-|-|fenced
step4=4@7|-|-|fenced
step5=3@8|-|-|serve

case=conflict_between_peers_reset_by_higher_epoch
step1=2@5|3@7|mismatched|fenced
step2=2@5|4@7|mismatched|fenced
step3=2@5|3@8|mismatched|fenced
step4=3@8|-|-|serve

case=conflict_below_local_epoch_ignored
step1=2@9|3@5|mismatched|serve
step2=2@9|4@5|mismatched|serve
step3=2@9|2@9|agreed|serve
